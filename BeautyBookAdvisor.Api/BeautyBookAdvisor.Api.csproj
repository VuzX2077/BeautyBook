<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework>net8.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup><ProjectReference Include="..\BeautyBookBackend\BeautyBookBackend.csproj" /></ItemGroup>
  <!-- Keep legacy backend configuration out of the isolated host publication. -->
  <Target Name="ExcludeBackendSettings" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.FullPath)', '[/\\]BeautyBookBackend[/\\]appsettings[^/\\]*\.json$'))" />
    </ItemGroup>
  </Target>
</Project>
