{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=BeautyBookDb;Username=postgres;Password=your_local_password"
  },
  "Jwt": {
    "Key": "replace_with_a_long_random_secret_at_least_32_chars",
    "Issuer": "BeautyBookBackend",
    "Audience": "BeautyBookClients",
    "DurationInMinutes": 1440
  },
  "Booking": {
    "TimeZoneId": "Asia/Ho_Chi_Minh"
  },
  "Refunds": {
    "AutomatedPayoutEnabled": false
  },
  "Supabase": {
    "Url": "https://your-project-ref.supabase.co",
    "ServiceRoleKey": "keep_this_server_side_only",
    "StorageBucket": "images"
  },
  "GoogleAuth": {
    "ClientIds": [
      "your_google_web_client_id.apps.googleusercontent.com"
    ]
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "Username": "bbooksupport@gmail.com",
    "AppPassword": "set-with-Email__AppPassword-environment-variable",
    "FromName": "BBook Support"
  },
  "Otp": {
    "HashKey": "set-a-long-random-secret-with-Otp__HashKey-environment-variable"
  },
    "PayOS": {
        "BaseUrl": "https://api-merchant.payos.vn",
        "ClientId": "your_payos_client_id",
        "ApiKey": "your_payos_api_key",
        "ChecksumKey": "your_payos_checksum_key",
        "BookingReturnUrl": "bbookapp://checkout/success",
        "BookingCancelUrl": "bbookapp://booking/{bookingId}"
    },
  "ApplyMigrations": true
}
